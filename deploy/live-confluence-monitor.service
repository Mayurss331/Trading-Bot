[Unit]
Description=Trading Bot Live Confluence Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/opt/trading-bot/.env
ExecStart=/opt/trading-bot/.venv/bin/python Crypto/live_confluence_monitor.py --pair B-ETH_USDT --market ETHUSDT --execution-mode futures --risk 10 --poll 15
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

